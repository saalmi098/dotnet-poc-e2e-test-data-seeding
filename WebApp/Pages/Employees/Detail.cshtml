@page "/employees/{id:int}"
@model WebApp.Pages.Employees.DetailModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Employee — @Model.Employee?.Name</title>
</head>
<body>
    <h1 class="employee-name">@Model.Employee?.Name</h1>
    <p class="employee-email">@Model.Employee?.Email</p>

    @if (Model.Employee?.Department != null)
    {
        <section class="department">
            <span class="department-street">@Model.Employee.Department.Street</span>,
            <span class="department-zipcode">@Model.Employee.Department.ZipCode</span>
            <span class="department-city">@Model.Employee.Department.City</span>
        </section>
    }
</body>
</html>
