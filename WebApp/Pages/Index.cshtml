@page
@model WebApp.Pages.IndexModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>POC — Test Data Seeding</title>
    <style>
        body { font-family: sans-serif; padding: 2rem; }
        table { border-collapse: collapse; width: 100%; margin-bottom: 2rem; }
        th, td { border: 1px solid #ccc; padding: 0.5rem 1rem; text-align: left; }
        th { background: #f0f0f0; }
        h2 { margin-top: 2rem; }
        tbody tr { cursor: pointer; }
        tbody tr:hover { background: #f9f9f9; }
        .toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
        .btn-add {
            padding: 0.4rem 1rem;
            background: #222;
            color: #fff;
            border: none;
            border-radius: 4px;
            font-size: 0.9rem;
            text-decoration: none;
            cursor: pointer;
        }
        .btn-add:hover { background: #444; }
    </style>
</head>
<body>
    <h1>POC — Test Data Seeding</h1>

    <div class="toolbar">
        <h2 style="margin: 0">Employees (@Model.Employees.Count)</h2>
        <a href="/employees" class="btn-add">+ Add Employee</a>
    </div>
    @if (Model.Employees.Count == 0)
    {
        <p>No employees in database.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Id</th><th>Name</th><th>Email</th><th>Department</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Employees)
                {
                    <tr onclick="location.href='/employees/@e.Id'">
                        <td>@e.Id</td>
                        <td class="employee-name">@e.Name</td>
                        <td class="employee-email">@e.Email</td>
                        <td>@(e.Department is not null ? $"{e.Department.Street}, {e.Department.ZipCode} {e.Department.City}" : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="toolbar">
        <h2 style="margin: 0">Departments (@Model.Departments.Count)</h2>
        <a href="/departments" class="btn-add">+ Add Department</a>
    </div>
    @if (Model.Departments.Count == 0)
    {
        <p>No departments in database.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Id</th><th>Street</th><th>City</th><th>Zip</th><th>Employees</th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Departments)
                {
                    <tr onclick="location.href='/departments/@a.Id'">
                        <td>@a.Id</td>
                        <td class="department-street">@a.Street</td>
                        <td class="department-city">@a.City</td>
                        <td class="department-zipcode">@a.ZipCode</td>
                        <td>@a.Employees.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</body>
</html>
